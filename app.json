{
  "expo": {
    "name": "MintyPOS",
    "slug": "MintyPOS",
    "version": "1.0.0",
    "orientation": "dafault",
    "icon": "./assets/logo/logo.png",
    "scheme": "mintypos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3D7066",
        "foregroundImage": "./assets/logo/logo.png",
        "backgroundImage": "./assets/logo/logo.png",
        "monochromeImage": "./assets/logo/logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/logo-text.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3D7066",
          "dark": {
            "backgroundColor": "#3D7066"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
